{
  "name": "codexlate",
  "displayName": "CodeXlate - Code-to-Plain-Language Translator",
  "description": "Translate code into plain language for non-engineers | 將程式碼逐段直譯為非工程師能看懂的句子 | 将代码逐段直译为非工程师能看懂的句子 | コードを非エンジニアにも分かる言葉に翻訳",
  "version": "0.4.0",
  "publisher": "reidevbx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reidevbx/codexlate"
  },
  "homepage": "https://github.com/reidevbx/codexlate#readme",
  "bugs": {
    "url": "https://github.com/reidevbx/codexlate/issues"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "keywords": [
    "translate",
    "code",
    "chinese",
    "japanese",
    "explanation",
    "ai",
    "documentation",
    "readability",
    "beginner-friendly",
    "code-review"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexlate.translate",
        "title": "CodeXlate: 翻譯程式碼"
      },
      {
        "command": "codexlate.selectModel",
        "title": "CodeXlate: 選擇模型"
      }
    ],
    "keybindings": [
      {
        "command": "codexlate.translate",
        "key": "ctrl+t x",
        "mac": "cmd+t x",
        "when": "editorTextFocus"
      },
      {
        "command": "codexlate.translate",
        "key": "ctrl+k x",
        "mac": "cmd+k x",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "CodeXlate",
      "properties": {
        "codexlate.language": {
          "type": "string",
          "default": "繁體中文",
          "enum": [
            "繁體中文",
            "简体中文",
            "English",
            "日本語"
          ],
          "description": "翻譯目標語言",
          "order": 0
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.27.1",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  }
}
